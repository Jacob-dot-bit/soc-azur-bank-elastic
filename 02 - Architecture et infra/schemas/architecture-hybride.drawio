<mxCell id="t" value="&lt;b&gt;Azur Bank · Architecture SIEM hybride : le sensible reste sur site, le volume part dans le cloud&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=23;fontColor=#1B2631;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1520" height="40" as="geometry"/></mxCell>
<mxCell id="onprem" value="&lt;b&gt;ON-PREM · AZUR BANK (siège + N agences reliées en VPN IPsec)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#263238;align=left;verticalAlign=top;fillColor=#F4F6F8;strokeColor=#5B6770;rounded=1;arcSize=6;strokeWidth=2;spacingLeft=12;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="860" height="680" as="geometry"/></mxCell>
<mxCell id="crit" value="&lt;b&gt;Données critiques : ne quittent jamais la banque&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#37474F;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#90A4AE;rounded=1;arcSize=6;strokeWidth=2;spacingLeft=12;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="400" height="260" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;db-clients-01&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;base clients&lt;br&gt;audit pgaudit (use case)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#7A4A00;align=center;verticalAlign=middle;fillColor=#FFF6E5;strokeColor=#B26A00;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="75" y="150" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="swift" value="&lt;b&gt;Passerelle SWIFT / SEPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;virements, MT103&lt;br&gt;SWIFT CSP&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#7A4A00;align=center;verticalAlign=middle;fillColor=#FFF6E5;strokeColor=#B26A00;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="265" y="150" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="cde" value="&lt;b&gt;Zone cartes (CDE)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;monétique, PAN&lt;br&gt;PCI DSS&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#7A4A00;align=center;verticalAlign=middle;fillColor=#FFF6E5;strokeColor=#B26A00;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="75" y="260" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="adbas" value="&lt;b&gt;AD + bastion-01&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;comptes, accès&lt;br&gt;privilégiés (MFA)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#3E2380;align=center;verticalAlign=middle;fillColor=#F1ECFA;strokeColor=#5E35B1;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="265" y="260" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="vol" value="&lt;b&gt;Sources volumineuses, moins sensibles&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#37474F;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#90A4AE;rounded=1;arcSize=6;strokeWidth=2;spacingLeft=12;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="400" height="260" as="geometry"/></mxCell>
<mxCell id="web" value="&lt;b&gt;web-portail-01&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DMZ · nginx / WAF&lt;br&gt;portail clients&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#8E1B1B;align=center;verticalAlign=middle;fillColor=#FDEEEE;strokeColor=#C62828;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="495" y="150" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="fw" value="&lt;b&gt;fw-01 · OPNsense&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;flux inter-zones&lt;br&gt;seule sortie Internet&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#BF360C;align=center;verticalAlign=middle;fillColor=#FFF3E0;strokeColor=#E65100;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="685" y="150" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="ws" value="&lt;b&gt;Postes des agences&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Elastic Defend (EDR)&lt;br&gt;+ Sysmon&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1B5E20;align=center;verticalAlign=middle;fillColor=#EAF6EC;strokeColor=#2E7D32;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="495" y="260" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="proxy" value="&lt;b&gt;Proxy, DNS, DHCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;VPN, Wi-Fi&lt;br&gt;(cible)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#455A64;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#78909C;rounded=1;arcSize=6;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="685" y="260" width="180" height="95" as="geometry"/></mxCell>
<mxCell id="soc" value="&lt;b&gt;Zone SOC (10.40.0.0/24)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#37474F;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#90A4AE;rounded=1;arcSize=6;strokeWidth=2;spacingLeft=12;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="820" height="315" as="geometry"/></mxCell>
<mxCell id="siem" value="&lt;b&gt;siem-elk-01 · cluster on-prem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fleet Server : pilote tous les agents&lt;br&gt;Elasticsearch : données critiques, 12 mois&lt;br&gt;Kibana Security : règles + console unique&lt;br&gt;des analystes (local + cloud via CCS)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#004D40;align=center;verticalAlign=middle;fillColor=#E0F7F5;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="380" height="150" as="geometry"/></mxCell>
<mxCell id="ls" value="&lt;b&gt;Logstash · seule sortie vers le cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;envoie : logs moins sensibles + alertes&lt;br&gt;retire : PAN, IBAN, noms, montants&lt;br&gt;file persistante : rien n'est perdu&lt;br&gt;si le lien Internet tombe&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#BF360C;align=center;verticalAlign=middle;fillColor=#FFF3E0;strokeColor=#E65100;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="shuffle" value="&lt;b&gt;SOAR Shuffle (phase 2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;lit les alertes, ouvre le case,&lt;br&gt;verrouille compte base + AD, bloque l'IP&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#004D40;align=center;verticalAlign=middle;fillColor=#E0F7F5;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="380" height="85" as="geometry"/></mxCell>
<mxCell id="anan" value="Analystes N1 / N2 : une seule console,&lt;br&gt;une recherche couvre les deux clusters,&lt;br&gt;sans copier les données" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#455A64;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="500" y="630" width="360" height="85" as="geometry"/></mxCell>
<mxCell id="cloud" value="&lt;b&gt;ELASTIC CLOUD (région UE)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0B3D91;align=left;verticalAlign=top;fillColor=#E8F1FD;strokeColor=#0B64DD;rounded=1;arcSize=6;strokeWidth=2;spacingLeft=12;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="520" height="450" as="geometry"/></mxCell>
<mxCell id="ces" value="&lt;b&gt;Elasticsearch cloud · autoscalé&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;logs web, firewall, postes, réseau (le gros du volume)&lt;br&gt;copie des alertes on-prem (survit à une panne du site)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0B3D91;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0B64DD;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1065" y="115" width="470" height="110" as="geometry"/></mxCell>
<mxCell id="cdet" value="&lt;b&gt;Règles sur les&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;données cloud&lt;br&gt;(SQLi, brute force,&lt;br&gt;EDR)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#004D40;align=center;verticalAlign=middle;fillColor=#E0F7F5;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1065" y="245" width="225" height="110" as="geometry"/></mxCell>
<mxCell id="cml" value="&lt;b&gt;Rétention longue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;à bas coût&lt;br&gt;(niveaux froid / gelé)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0B3D91;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0B64DD;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1310" y="245" width="225" height="110" as="geometry"/></mxCell>
<mxCell id="cdash" value="&lt;b&gt;Dashboards direction (COMEX)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;posture, incidents par criticité, MTTD / MTTR&lt;br&gt;consultables hors du réseau de la banque&lt;br&gt;sans exposer aucune donnée client&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#004D40;align=center;verticalAlign=middle;fillColor=#E0F7F5;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1065" y="375" width="470" height="120" as="geometry"/></mxCell>
<mxCell id="nodup" value="&lt;b&gt;Pourquoi on ne duplique pas tout dans le cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;1. Coût : chaque Go stocké deux fois est payé deux fois&lt;br&gt;2. Une seule source de vérité : pas de preuve divergente en audit&lt;br&gt;3. Périmètre PCI DSS / SWIFT CSP réduit au seul site&lt;br&gt;4. Le CCS donne déjà la vue unique : on interroge,&lt;br&gt;    on ne recopie pas&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=left;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="545" width="520" height="205" as="geometry"/></mxCell>
<mxCell id="e_crit" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#00897B;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4737;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="crit" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_vol" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#00897B;strokeWidth=2;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="vol" target="ls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_alert" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#00897B;strokeWidth=2;exitX=1.0000;exitY=0.6667;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="1" source="siem" target="ls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l_alert" value="alertes" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#00695C;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="455" y="530" width="50" height="26" as="geometry"/></mxCell>
<mxCell id="e_out" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#00897B;strokeWidth=2;exitX=1.0000;exitY=0.4000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls" target="ces"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="915" y="520"/><mxPoint x="915" y="170"/></Array></mxGeometry></mxCell>
<mxCell id="l_out" value="HTTPS 443&lt;br&gt;sortant,&lt;br&gt;filtré" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#00695C;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="922" y="190" width="92" height="70" as="geometry"/></mxCell>
<mxCell id="e_ccs" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#0B64DD;strokeWidth=2;exitX=0.8421;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0481;entryY=0.3000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="siem" target="cloud"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="622"/><mxPoint x="1020" y="622"/><mxPoint x="1020" y="205"/></Array></mxGeometry></mxCell>
<mxCell id="l_ccs" value="Cross-Cluster&lt;br&gt;Search&lt;br&gt;requêtes à la&lt;br&gt;demande,&lt;br&gt;TLS sortant" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#0B3D91;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="922" y="500" width="95" height="110" as="geometry"/></mxCell>
<mxCell id="e_soar" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#8E24AA;strokeWidth=2;exitX=0.1842;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1842;entryY=1.0133;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="shuffle" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1" value="&lt;b&gt;Stable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;collecte, stockage et détection du critique sur site&lt;br&gt;une coupure cloud n'arrête ni la collecte ni la détection&lt;br&gt;un seul flux sortant, aucun port entrant&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="500" height="115" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Scalable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;les sources qui grossissent le plus partent dans le cloud&lt;br&gt;le site n'est dimensionné que pour le périmètre critique&lt;br&gt;nouveau site = agent + jeton d'enrôlement Fleet&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="550" y="770" width="500" height="115" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;Conforme&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;cartes, clients et SWIFT restent dans la banque&lt;br&gt;filtrage à la sortie, TLS, RBAC, région UE (RGPD, DORA)&lt;br&gt;12 mois de rétention (PCI DSS 10.5.1)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="770" width="500" height="115" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>