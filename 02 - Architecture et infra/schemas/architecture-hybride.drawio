<mxCell id="p1" value="&lt;b&gt;Stable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Fleet Server on-prem : la collecte continue même sans le cloud&lt;br&gt;partie Cloud managée par l'éditeur (SaaS)&lt;br&gt;agents pilotés via Fleet, aucun flux entrant depuis Internet&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="500" height="110" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Scalable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;stockage et calcul autoscalés selon le volume&lt;br&gt;nouveau site = installer l'agent + jeton d'enrôlement&lt;br&gt;une politique par rôle, réutilisée partout&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="550" y="770" width="500" height="110" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;Conforme&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TLS en transit, chiffrement au repos, SSO + RBAC&lt;br&gt;rétention 12 mois des journaux (PCI DSS 10.5.1)&lt;br&gt;production : région UE (RGPD, DORA)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#263238;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#00897B;rounded=1;arcSize=6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="770" width="500" height="110" as="geometry"/></mxCell>
